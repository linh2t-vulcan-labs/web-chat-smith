# apps/super-app/.env.example
#
# Template for local dev / local prod testing (`bun run prod sa --env=apps/super-app/.env.local`).
# Copy to `.env.local` (gitignored) and fill in real values. Both plain
# `next dev`/`next start` and `docker-compose.local.yml`'s `sa` service
# (via `env_file:`) read from this same `.env.local` — one source of truth
# for local runtime values.
#
# This list is exhaustive: every key here is validated by @cs/env
# (packages/env) and actually read somewhere in apps/super-app. Do
# not add keys "just in case" — an unused key here will silently drift from
# the code again (bun tools/internal/validate-config.ts catches this drift).
# Add new keys to packages/env's schema.ts before adding them here.

#### RUNTIME (CS_PUBLIC_*) — read from the container's real process env at ####
#### request time; never baked into the image. See packages/env.          ####

CS_PUBLIC_API_BASE_URL=
CS_PUBLIC_APP_ID=
CS_PUBLIC_CDN_PREFIX=
CS_PUBLIC_CHAT_SERVICE_URL=
CS_PUBLIC_DELAY_TIME_MANAGE_SUBSCRIPTION=4000
CS_PUBLIC_ENV_NAME=dev
CS_PUBLIC_FIREBASE_AUTH_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":"","measurementId":""}
CS_PUBLIC_FIREBASE_REMOTE_CONFIG_INTERVAL_FETCH=0
CS_PUBLIC_FIREBASE_VAPID_KEY=
CS_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
CS_PUBLIC_ORDER_SERVICE_URL=
CS_PUBLIC_PADDLE_CLIENT_TOKEN=
CS_PUBLIC_PAYMENT_SERVICE_URL=
CS_PUBLIC_PRODUCT_SERVICE_URL=
CS_PUBLIC_SMITH_ENGINE_SERVICE_URL=
CS_PUBLIC_SUBSCRIPTION_SERVICE_URL=
CS_PUBLIC_TURNSTILE_CAPTCHA_SITEKEY=
CS_PUBLIC_USER_MANAGEMENT_SERVICE_URL=
CS_PUBLIC_WEB_URL=http://localhost:3000

# AppsFlyer web app id — optional, folded into the schema during the
# CS_PUBLIC_ migration (previously read raw via process.env, unvalidated).
CS_PUBLIC_AF_WEB_APP_ID=

# Coralogix RUM (error/perf tracking) — wired via libs/coralogix/configs.ts
CS_PUBLIC_CORALOGIX_ENVIRONMENT=
CS_PUBLIC_CORALOGIX_APP_VERSION=
CS_PUBLIC_CORALOGIX_APPLICATION_NAME=
CS_PUBLIC_CORALOGIX_PUBLIC_KEY=
CS_PUBLIC_CORALOGIX_ACCOUNT_DOMAIN=

# Design-studio SEO metadata — has a fallback default, safe to leave blank locally
CS_PUBLIC_SITE_URL=https://chatsmith.io

#### RUNTIME (server-only secrets) — read at request time, never baked into the image ####

# Tracking (server-only, despite being GTM/GA products — no CS_PUBLIC_ prefix)
GTM_ID=
GTM_AUTH=
GTM_PREVIEW=

# Auth
JWT_SECRET=
JWT_MAX_AGE_SESSION=7776000

# Guest mode
GUEST_SESSION_SECRET_KEY=
GUEST_SESSION_MAX_AGE=2592000

# Sanity — non-secret identifiers + the real API token/revalidate interval.
# /sitemap.xml is force-dynamic, so these resolve at request time like
# everything else in this section (no build-arg needed).
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=
SANITY_USE_CDN=false
SANITY_API_TOKEN=
SANITY_REVALIDATE_TIME=3600

# Optional — origin sent on guest/anon CSRF-protected calls when it must differ
# from CS_PUBLIC_WEB_URL (e.g. localhost against a staging backend allowlist)
ANON_CSRF_ORIGIN=
