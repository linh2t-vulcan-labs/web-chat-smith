{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      // Turbo 2.x strict env mode only auto-passes NEXT_PUBLIC_* (Next.js
      // framework inference). /sitemap.xml is statically prerendered against
      // Sanity during `next build` (src/libs/sanity/sanity-server-client.ts),
      // so these non-secret identifiers must be explicitly allowlisted or the
      // build subprocess never sees them even though they're exported in the
      // parent shell. SANITY_API_TOKEN stays out — sitemap generation only
      // reads the public/CDN dataset.
      //
      // CS_PUBLIC_* is deliberately NOT listed here — super-app's public
      // config resolves at container-start/request time (packages/env),
      // not at build time, so it no longer affects build output at all and
      // shouldn't invalidate the build cache. Don't "fix" this by adding it.
      "passThroughEnv": [
        "SANITY_PROJECT_ID",
        "SANITY_DATASET",
        "SANITY_API_VERSION",
        "SANITY_USE_CDN"
      ]
    }
  }
}
