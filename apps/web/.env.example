# apps/web/.env.example
#
# Template for local dev. Copy to `.env.local` (gitignored) and fill in real
# values.
#
# This list is exhaustive: every key here is validated by @cs/env
# (packages/env) and actually read somewhere in apps/web (directly or via a
# @cs/* package apps/web depends on). Do not add keys "just in case" — add
# new keys to packages/env's schema.ts first, and only list them here once
# something in apps/web's dependency tree actually reads them.
#
# Unlike apps/super-app, @cs/api-client resolves every backend microservice
# under a SINGLE base URL (CS_PUBLIC_API_BASE_URL) plus a per-call service
# path segment — there is no CS_PUBLIC_<SERVICE>_SERVICE_URL per service here.

#### RUNTIME (CS_PUBLIC_*) — read from the container's real process env at ####
#### request time; never baked into the image. See packages/env.          ####

# Single backend base URL for every @cs/api-client call (packages/api-client/
# src/utils/runtime-env.ts). Required — requests throw without it.
CS_PUBLIC_API_BASE_URL=
# Sent as a request header by the user-management service calls.
CS_PUBLIC_APP_ID=
# Gates CSP/CORS behavior in @cs/security (isProd check).
CS_PUBLIC_ENV_NAME=dev
# Cookie domain wildcard added to the CSP/allowed-origins list (@cs/security).
CS_PUBLIC_COOKIE_DOMAIN=
# This app's own origin — CSP/allowed-origins list (@cs/security) and the
# `allowedDevOrigins` derived in next.config.ts.
CS_PUBLIC_WEB_URL=http://localhost:3000
# JSON-serialized Firebase web config blob (apiKey/authDomain/projectId/...).
# Required by @cs/firebase/config's getFirebaseConfigFromEnv() — used by
# Firebase Auth sign-in, @cs/flags' Firebase Remote Config adapter, and
# @cs/notifications' FCM messaging client.
CS_PUBLIC_FIREBASE_AUTH_CONFIG=
# Web Push certificate (VAPID key) from the Firebase console's Cloud
# Messaging settings. Required by @cs/notifications' NotificationsProvider.
CS_PUBLIC_FIREBASE_VAPID_KEY=
# Optional minimum fetch interval (ms) for the Remote Config flags adapter.
# Leave unset in staging/prod (deliberate choice, not an oversight) to use the
# Firebase SDK's own default (12h) — returning users within that window read
# flags from Remote Config's local IndexedDB cache with no network round trip,
# and useFlag() resolves synchronously to the schema default regardless, so a
# stale cache never blocks first paint. Only set this to `0` for local dev,
# where you want every reload to pick up console changes immediately.
CS_PUBLIC_FIREBASE_REMOTE_CONFIG_INTERVAL_FETCH=
# Cloudflare Turnstile site key for the invisible captcha challenge required
# by guest-session creation (components/providers/guest-session-provider.tsx).
# The widget renders with options={{ size: "invisible" }} — use Cloudflare's
# INVISIBLE test sitekeys, not the visible ones (mismatched type causes
# error 600010 "generic challenge failure"):
#   1x00000000000000000000BB — always passes (use this for local dev)
#   2x00000000000000000000BB — always fails (use to test the retry/give-up path)
CS_PUBLIC_TURNSTILE_CAPTCHA_SITEKEY=

#### SERVER (secrets — never exposed to the browser) — see packages/env. ####

# Origin sent on CSRF-protected guest-session calls to the User Management
# Service (packages/api-client/src/server/guest/session.ts). Overrides
# CS_PUBLIC_WEB_URL for local dev against a staging backend allowlist
# (localhost is rejected there). Optional.
ANON_CSRF_ORIGIN=
# Guest session cookie lifetime in seconds (packages/api-client/src/server/
# guest/cookies.ts). Defaults to 2592000 (30 days).
GUEST_SESSION_MAX_AGE=2592000
# 32-byte key (64 hex chars) encrypting the guest_session cookie via jose
# (packages/api-client/src/server/guest/cookies.ts). Required for guest
# sessions to work — generate with `openssl rand -hex 32`.
GUEST_SESSION_SECRET_KEY=
