{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun -bun next dev",
    "build": "bun -bun next build",
    "prestart": "cp -r .next/static .next/standalone/apps/web/.next/",
    "start": "bun run .next/standalone/apps/web/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next node_modules",
    "analyze": "next experimental-analyze"
  },
  "dependencies": {
    "@cs/api-client": "workspace:*",
    "@cs/core": "workspace:*",
    "@cs/env": "workspace:*",
    "@cs/firebase": "workspace:*",
    "@cs/flags": "workspace:*",
    "@cs/i18n": "workspace:*",
    "@cs/next-config": "workspace:*",
    "@cs/notifications": "workspace:*",
    "@cs/security": "workspace:*",
    "@cs/themes": "workspace:*",
    "@cs/ui": "workspace:*",
    "@marsidev/react-turnstile": "catalog:integrations",
    "@tanstack/react-query": "catalog:data",
    "firebase": "catalog:integrations",
    "next": "catalog:framework",
    "next-intl": "catalog:framework",
    "react": "catalog:framework",
    "react-dom": "catalog:framework"
  },
  "devDependencies": {
    "@cs/ts-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:ui",
    "@types/bun": "catalog:tools",
    "@types/node": "catalog:tools",
    "@types/react": "catalog:framework",
    "@types/react-dom": "catalog:framework",
    "typescript": "catalog:tools"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 edge versions"
  ]
}
