    "@cs/security": "workspace:*",
    "@cs/themes": "workspace:*",
    "@cs/ui": "workspace:*",
    "@marsidev/react-turnstile": "catalog:integrations",
    "@tanstack/react-query": "catalog:data",
    "ai": "catalog:integrations",
    "firebase": "catalog:integrations",
    "lucide-react": "catalog:ui",
