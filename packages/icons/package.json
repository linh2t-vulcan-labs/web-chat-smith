{
  "name": "@cs/icons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./generated-icons/index.ts",
    "./*": [
      "./generated-icons/icons_v1/graphics/*.tsx",
      "./generated-icons/icons_v1/icons/*.tsx"
    ],
    "./latest/*": [
      "./generated-icons/icons_v1/graphics/*.tsx",
      "./generated-icons/icons_v1/icons/*.tsx"
    ],
    "./icons_v1/*": [
      "./generated-icons/icons_v1/graphics/*.tsx",
      "./generated-icons/icons_v1/icons/*.tsx"
    ]
  },
  "scripts": {
    "gen": "bun run scripts/generate-icons.ts",
    "icons": "bun run scripts/icons.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "devDependencies": {
    "@cs/ts-config": "workspace:*",
    "@types/bun": "catalog:tools",
    "@types/node": "catalog:tools",
    "@types/react": "catalog:framework",
    "@types/react-dom": "catalog:framework",
    "typescript": "catalog:tools"
  },
  "peerDependencies": {
    "react": "catalog:framework",
    "react-dom": "catalog:framework"
  }
}
