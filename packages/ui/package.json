{
  "name": "@cs/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "imports": {
    "#components/shadcn/*": "./src/components/shadcn/*/index.ts",
    "#components/ai-elements/*": "./src/components/ai-elements/*.tsx",
    "#components/cs/*": "./src/components/cs/*/index.ts",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
