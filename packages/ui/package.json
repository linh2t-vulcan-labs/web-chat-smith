{
  "name": "@cs/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "imports": {
    "#components/*": "./src/components/*/index.ts",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*/index.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui",
    "@cs/core": "workspace:*",
    "@cs/design-tokens": "workspace:*",
    "@cs/i18n": "workspace:*",
    "@cs/icons": "workspace:*",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "lucide-react": "catalog:ui",
    "next-intl": "catalog:framework",
    "react": "catalog:framework",
    "react-dom": "catalog:framework",
    "shadcn": "catalog:ui",
    "tailwind-merge": "catalog:ui",
    "tw-animate-css": "catalog:ui",
    "zod": "catalog:validation"
  },
  "devDependencies": {
    "@cs/ts-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:ui",
    "@types/react": "catalog:framework",
    "@types/react-dom": "catalog:framework",
    "tailwindcss": "catalog:ui",
    "typescript": "catalog:tools"
  }
}
