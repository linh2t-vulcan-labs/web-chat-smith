{
  "$schema": "https://turbo.build/schema.json",
  "boundaries": {
    "tags": {
      "tools": {
        "dependencies": {
          "deny": ["foundation", "shared", "ui", "app"]
        }
      },
      "foundation": {
        "dependencies": {
          "deny": ["shared", "ui", "app"]
        }
      },
      "shared": {
        "dependencies": {
          "deny": ["ui", "app"]
        }
      },
      "ui": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "app": {
        "dependencies": {
          "deny": ["app"]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["CS_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {},
    "start": {},
    "analyze": {}
  }
}
